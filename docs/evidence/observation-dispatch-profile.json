    "probeSource": "import { test, expect } from '@playwright/test';\nimport { writeFileSync } from 'node:fs';\nimport { Driver as Baseline } from './baseline.mjs';\nimport { Driver as Candidate } from './candidate.mjs';\nimport { tabsHtml, tabsContract } from '../../tests/fixtures/tabs.js';\nimport { DEFAULTS } from '../../src/contracts/common.js';\n\nfor (const [name, Driver] of [['baseline', Baseline], ['candidate', Candidate]] as const) {\n  test(name, async ({ page }) => {\n    await page.setContent(tabsHtml({ activation: 'manual' }));\n    const c = tabsContract(page, { activation: 'manual' });\n    const d = new Driver(page, [c.tablist, ...c.items.flatMap(i => [i.tab, i.panel])], c.tablist,\n      { ...DEFAULTS }, performance.now(), c);\n    const original = Error.prepareStackTrace;\n    const frameCounts: number[] = [];\n    let measuring = false;\n    try {\n      await d.snapshot('interaction');\n      Error.prepareStackTrace = (error, frames) => {\n        if (measuring) frameCounts.push(frames.length);\n        return original(error, frames);\n      };\n      async function callerChain(depth: number): Promise<void> {\n        await Promise.resolve();\n        if (depth) await callerChain(depth - 1);\n        else expect((await d.snapshot('interaction')).tabs?.structure).toBe(true);\n      }\n      measuring = true;\n      await callerChain(24);\n      measuring = false;\n      expect(frameCounts.length).toBeGreaterThan(0);\n      writeFileSync(`artifacts/stack-probe/${name}-frames.json`, JSON.stringify({\n        scope: 'One warmed interaction snapshot through a 24-level async caller chain. The existing stack formatter is forwarded unchanged; only frame counts are recorded.',\n        name, frameCounts, formattedStacks: frameCounts.length,\n        totalMappedFrames: frameCounts.reduce((a,b) => a+b, 0), maximumFrames: Math.max(...frameCounts),\n      }, null, 2) + '\\n');\n    } finally { measuring = false; Error.prepareStackTrace = original; await d.dispose(); }\n  });\n}\n",
    "files": {
      "baseline.mjs": "ad248113a0b684f8dc0adddc32458c3b1cd0bcc77afb1a2151979a0469c9b59d",
