{
  "name": "keytrail",
  "version": "0.1.0-alpha.5",
  "description": "Keyboard journey checks for dialogs, tabs and form errors in Playwright",
  "type": "module",
  "license": "Apache-2.0",
  "author": "PerchAnton",
  "repository": {
    "type": "git",
    "url": "https://github.com/PerchAnton/keytrail.git"
  },
  "homepage": "https://github.com/PerchAnton/keytrail#readme",
  "bugs": {
    "url": "https://github.com/PerchAnton/keytrail/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema/journey-result.v1.json": "./schema/journey-result.v1.json",
    "./ci-guard": {
      "import": {
        "types": "./dist/ci-guard.d.ts",
        "default": "./dist/ci-guard.js"
      },
      "require": {
        "types": "./dist/ci-guard.d.cts",
        "default": "./dist/ci-guard.cjs"
      }
    }
  },
  "files": [
    "dist",
    "schema",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "peerDependencies": {
    "@playwright/test": "1.64.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "esbuild": "0.28.2",
    "ajv": "8.20.0",
    "@types/node": "24.10.1"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:browser": "playwright test",
    "test:package": "node scripts/check-package.mjs",
    "check": "pnpm build && pnpm test:types && pnpm test:unit && pnpm test:guard && pnpm test:browser && pnpm test:package",
    "prepack": "pnpm build",
    "test:types": "tsc -p tsconfig.tests.json",
    "test:guard": "node scripts/check-guard.mjs",
    "verify:reliability": "node scripts/verify-reliability.mjs",
    "benchmark": "playwright test --config benchmarks/playwright.config.ts"
  }
}
